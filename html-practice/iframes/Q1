<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Question 1: Embed a YouTube video using an iframe with percentage-based sizing -->
    <meta charset="UTF-8">
    <title>Q1 - YouTube Video Embed</title>
</head>
<body>

    <h1>My Favorite YouTube Video</h1>

    <!-- Width and height are set using percentage values so the iframe resizes
         responsively with the browser window instead of staying a fixed pixel size -->
    <iframe
        src="https://www.youtube.com/embed/dQw4w9WgXcQ"
        width="80%"
        height="60%"
        title="YouTube video player">
    </iframe>

</body>
</html>
