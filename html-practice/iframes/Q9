<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Question 9: File Upload Form restricted to .jpg and .png -->
    <meta charset="UTF-8">
    <title>Q9 - File Upload Form</title>
</head>
<body>

    <h1>Upload an Image</h1>

    <form action="#" method="post" enctype="multipart/form-data">

        <label for="imagefile">Choose a file:</label>
        <!-- The accept attribute restricts the file picker to only .jpg and .png files -->
        <input type="file" id="imagefile" name="imagefile" accept=".jpg,.png">
        <br><br>

        <input type="submit" value="Upload">

    </form>

    <p>Only image files with the .jpg or .png extension are allowed to be uploaded.</p>

</body>
</html>
