<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Question 11: Student Information Form with a select dropdown -->
    <meta charset="UTF-8">
    <title>Q11 - Student Information Form</title>
</head>
<body>

    <h1>Student Information</h1>

    <form action="#" method="post">

        <label for="name">Name:</label>
        <input type="text" id="name" name="name" required>
        <br><br>

        <label for="rollnumber">Roll Number:</label>
        <input type="text" id="rollnumber" name="rollnumber" required>
        <br><br>

        <label for="course">Course:</label>
        <select id="course" name="course" required>
            <!-- Default option shown before the user picks a real course; disabled so it
                 cannot be re-selected, and selected so it appears first -->
            <option value="" disabled selected>Select Course</option>
            <option value="bca">BCA</option>
            <option value="bsc-cs">B.Sc Computer Science</option>
            <option value="btech-cse">B.Tech CSE</option>
            <option value="mca">MCA</option>
        </select>
        <br><br>

        <input type="submit" value="Submit">

    </form>

</body>
</html>
